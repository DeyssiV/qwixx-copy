<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.StartPaginaController">
   <children>
      <HBox alignment="TOP_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnNL" focusTraversable="false" alignment="CENTER" onAction="#wisselNaarNederlands" text="NL" textAlignment="CENTER"/>
            <Button fx:id="btnEN" focusTraversable="false" alignment="CENTER" onAction="#wisselNaarEngels" text="EN" textAlignment="CENTER" />
            <Button fx:id="btnRU" focusTraversable="false" alignment="CENTER" onAction="#wisselNaarRussisch" text="RU" textAlignment="CENTER" />
         </children>
         <padding>
            <Insets right="20.0" top="20.0" />
         </padding>
      </HBox>

      <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
      <Label alignment="CENTER" contentDisplay="CENTER" text="%titel" textAlignment="CENTER">
         <font>
            <Font name="Calibri" size="94.0" />
         </font>
         <VBox.margin>
            <Insets bottom="50.0" />
         </VBox.margin>
      </Label>


      <Button fx:id="btnNieuwSpel" focusTraversable="false" alignment="CENTER" onAction="#nieuwSpelKnopIngedrukt" text="%StartSpel" textAlignment="CENTER">
         <font>
            <Font name="Calibri" size="25.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="btnNieuweSpeler" focusTraversable="false" alignment="CENTER" mnemonicParsing="false" onAction="#nieuweSpelerToevoegen" text="%SpelerToevoegen">
         <font>
            <Font name="Calibri" size="25.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </Button>
      </VBox>
   </children>
</VBox>
