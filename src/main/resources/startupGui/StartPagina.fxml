<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox stylesheets="@style.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="startupGui.StartPaginaController">

   <HBox alignment="TOP_RIGHT" spacing="10.0">

      <padding>
         <Insets right="20.0" top="20.0"/>
      </padding>

      <Button id="btnNL" alignment="CENTER" onAction="#wisselNaarNederlands" text="NL" textAlignment="CENTER"/>
      <Button id="btnEN" alignment="CENTER" onAction="#wisselNaarEngels" text="EN" textAlignment="CENTER"/>
      <Button id="btnRU" alignment="CENTER" onAction="#wisselNaarRussisch" text="RU" textAlignment="CENTER"/>

   </HBox>

   <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">

   <Label id="lblTitelSP" alignment="CENTER" contentDisplay="CENTER" text="%lblTitel-SP" textAlignment="CENTER">
      <VBox.margin>
         <Insets bottom="30.0"/>
      </VBox.margin>
   </Label>

   <Button fx:id="btnStartSpelSP" alignment="CENTER" onAction="#nieuwSpelKnopIngedrukt" text="%btnStartSpel-SP" textAlignment="CENTER">
      <VBox.margin>
         <Insets bottom="15.0" top="10.0"/>
      </VBox.margin>
   </Button>

   <Button fx:id="btnSpelerToevoegenSP" alignment="CENTER" onAction="#nieuweSpelerToevoegen" text="%btnSpelerToevoegen-SP">
      <VBox.margin>
         <Insets bottom="15.0" top="10.0"/>
      </VBox.margin>
   </Button>

      <Button fx:id="btnSpelRegelsSP" alignment="CENTER" onAction="#toonSpelregels" text="%btnSpelRegels-SP">
         <VBox.margin>
            <Insets bottom="15.0" top="10.0"/>
         </VBox.margin>
      </Button>

      <Button fx:id="btnStatsSP" alignment="CENTER" onAction="#toonStats" text="%btnStats-SP"/>

   </VBox>
</VBox>
