<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.StackPane?>
<BorderPane stylesheets="@style.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.SpelregelsController">
    <top>
        <VBox alignment="CENTER" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <StackPane>
                <Label id="lblTitelSRP" text="%lblTitel-SRP" StackPane.alignment="CENTER"/>
                <Button fx:id="btnAnnuleren" id="btnAnnuleren" onAction="#annuleer" text="←" StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets left="20.0"/>
                    </StackPane.margin>
                </Button>
            </StackPane>
        </VBox>
    </top>
   <center>
       <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
           <Accordion>
               <panes>
                   <TitledPane animated="false" text="%Stap1Titel">
                       <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="30.0" prefWidth="200.0">
                           <Label layoutX="14.0" layoutY="7.0" text="%Stap1Tekst"/>
                       </AnchorPane>
                   </TitledPane>
                   <TitledPane animated="false" text="%Stap2Titel">
                       <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="300.0" prefWidth="200.0">
                           <Label layoutX="14.0" layoutY="6.0" text="%Stap2TekstDeel1"/>
                           <Label styleClass="lblTussentitelSRP" layoutX="14.0" layoutY="60.0" text="%Stap2Tussentitel1"/>
                           <Label layoutX="14.0" layoutY="91.0" text="%Stap2TekstDeel2"/>
                           <Label styleClass="lblTussentitelSRP" layoutX="14.0" layoutY="119.0" text="%Stap2Tussentitel2"/>
                           <Label layoutX="14.0" layoutY="151.0" text="%Stap2TekstDeel3"/>
                           <Label styleClass="lblTussentitelSRP" layoutX="14.0" layoutY="210.0" text="%Stap2Tussentitel3"/>
                           <Label layoutX="14.0" layoutY="240.0" text="%Stap2TekstDeel4"/>
                       </AnchorPane>
                   </TitledPane>
                   <TitledPane animated="false" text="%Stap3Titel">
                       <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="400.0" prefWidth="200.0">
                           <Label layoutX="14.0" layoutY="14.0" text="%Stap3TekstDeel1"/>
                           <Label styleClass="lblTussentitelSRP" layoutX="14.0" layoutY="51.0" text="%Stap3Tussentitel1"/>
                           <Label layoutX="14.0" layoutY="82.0" text="%Stap3TekstDeel2"/>
                           <Label styleClass="lblTussentitelSRP" layoutX="14.0" layoutY="104.0" text="%Stap3Tussentitel2"/>
                           <Label layoutX="14.0" layoutY="142.0" text="%Stap3TekstDeel3"/>
                       </AnchorPane>
                   </TitledPane>
                   <TitledPane animated="false" text="%Stap4Titel">
                       <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="30.0" prefWidth="200.0">
                           <Label layoutX="14.0" layoutY="7.0" text="%Stap4Tekst"/>
                       </AnchorPane>
                   </TitledPane>
               </panes>
           </Accordion>
       </VBox>
   </center>
</BorderPane>
