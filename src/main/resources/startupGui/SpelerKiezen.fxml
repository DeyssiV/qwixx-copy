<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.SpelerKiezenController">
   <children>
      <ComboBox fx:id="cmbLijstSpelers" layoutX="14.0" layoutY="14.0" prefHeight="36.0" prefWidth="185.0" promptText="Beschikbare Spelers" />
      <Button fx:id="btnVoegSpelerToe" layoutX="211.0" layoutY="14.0" mnemonicParsing="false" onAction="#voegSpelerToe" scaleX="1.03187" text="Voeg Speler Toe">
         <font>
            <Font name="Calibri" size="20.0" />
         </font>
      </Button>
      <ListView fx:id="lvGekozenSpelers" layoutX="380.0" layoutY="14.0" prefHeight="200.0" prefWidth="200.0" />
      <Button fx:id="btnVerwijder" layoutX="209.0" layoutY="60.0" mnemonicParsing="false" onAction="#verwijderSpeler" text="Verwijder Speler">
         <font>
            <Font name="Calibri" size="20.0" />
         </font>
      </Button>
      <Button fx:id="btnAnnuleer" layoutX="372.0" layoutY="349.0" mnemonicParsing="false" onAction="#annuleer" text="Terug naar Hoofdmenu">
         <font>
            <Font name="Calibri" size="20.0" />
         </font>
      </Button>
      <Button fx:id="btnStartSpel" layoutX="397.0" layoutY="281.0" mnemonicParsing="false" onAction="#startSpel" text="Start Spel">
         <font>
            <Font name="Calibri" size="32.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
