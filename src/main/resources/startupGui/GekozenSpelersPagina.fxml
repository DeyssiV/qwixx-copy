<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.GekozenSpelersPaginaController">
    <top>
        <VBox alignment="CENTER" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <StackPane>
                <padding>
                    <Insets bottom="10.0" top="20.0"/>
                </padding>
                <Label id="lblTitelGSP" text="%lblTitel-GSP" StackPane.alignment="CENTER"/>

                <Button fx:id="btnAnnuleren" id="btnAnnuleren" onAction="#annuleer" text="←" StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets left="20.0"/>
                    </StackPane.margin>
                </Button>
            </StackPane>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <Label styleClass="lblTussentitelSRP" text="%lblVolgordeSpelers-GSP"/>
            <ListView fx:id="lijstGekozenSpelers" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="10.0"/>
            </padding>
            <Button fx:id="btnStartSpel" id="btnStartSpel" onAction="#startSpel" text="%lblVolgende-GSP"/>
        </HBox>
    </bottom>
</BorderPane>