<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.GekozenSpelersPaginaController">
    <top>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <StackPane>
                    <children>
                        <Label fx:id="lblGekozenSpelers" id="lblTitelSub" text="%GekozenSpelers" StackPane.alignment="CENTER" />

                        <Button fx:id="btnAnnuleer" id="btnAnnuleer" onAction="#handleAnnuleer" text="←" StackPane.alignment="CENTER_LEFT">
                            <StackPane.margin>
                                <Insets left="20.0" />
                            </StackPane.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets bottom="10.0" top="20.0" />
                    </padding>
                </StackPane>
            </children>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="%VolgordeSpelers:">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <ListView fx:id="lvGekozenSpelers" maxWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" />
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnStartSpel" id="btnToonSpelregels" mnemonicParsing="false" onAction="#handleStartSpel" prefHeight="60.0" prefWidth="180.0" text="%Volgende">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" left="10.0" right="20.0" top="10.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>