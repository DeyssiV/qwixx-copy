<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane stylesheets="@style.css" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.SpelerToevoegenController">
   <top>
      <VBox alignment="CENTER" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <StackPane>
            <Label fx:id="lblSpelerToevoegen" id="lblTitelSub" text="%SpelerKiezenSpelerToevoegen"
                   StackPane.alignment="CENTER"/>

            <Button fx:id="btnAnnuleren" id="btnAnnuleer" onAction="#annuleerRegistratie" text="←"
                    StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets left="20.0"/>
               </StackPane.margin>
            </Button>
         </StackPane>

         <Label fx:id="lblFeedback" textAlignment="CENTER"/>
      </VBox>
   </top>

   <center>
      <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <TextField fx:id="txfNaam" maxWidth="250.0" promptText="%txtNaam">
                     <font>
                        <Font name="Calibri" size="20.0" />
                     </font>
                  </TextField>
                  <TextField fx:id="txfGeboortejaar" maxWidth="250.0" promptText="%txtGeboortejaar">
                     <font>
                        <Font name="Calibri" size="20.0" />
                     </font>
                  </TextField>
               </children>
            </HBox>

            <Button fx:id="btnRegistreren" mnemonicParsing="false" onAction="#startRegistratieSpeler" prefWidth="200.0" text="%Registreren">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets bottom="50.0" />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
