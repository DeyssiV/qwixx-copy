<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.SpelerToevoegenController">
   <children>
      <TextField fx:id="txfNaam" layoutX="47.0" layoutY="182.0" promptText="Naam">
         <font>
            <Font name="Calibri" size="20.0" />
         </font>
      </TextField>
      <TextField fx:id="txfGeboortejaar" layoutX="315.0" layoutY="182.0" promptText="Geboortejaar">
         <font>
            <Font name="Calibri" size="20.0" />
         </font>
      </TextField>
      <Button fx:id="btnRegistreren" layoutX="224.0" layoutY="260.0" mnemonicParsing="false" onAction="#startRegistratieSpeler" text="Registreren">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
      <Label fx:id="lblSpelerToevoegen" layoutX="170.0" layoutY="63.0" text="Speler Toevoegen">
         <font>
            <Font size="33.0" />
         </font>
      </Label>
      <Button fx:id="btnAnnuleren" layoutX="232.0" layoutY="323.0" mnemonicParsing="false" onAction="#annuleerRegistratie" text="annuleren">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
