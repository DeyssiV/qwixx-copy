<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.layout.BorderPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="startupGui.SpelerToevoegenController">
   <top>
      <Button fx:id="btnAnnuleren" onAction="#annuleerRegistratie" text="%Annuleren" BorderPane.alignment="TOP_LEFT">
         <font>
            <Font size="18.0" />
         </font>
         <BorderPane.margin>
            <Insets left="20.0" top="20.0" />
         </BorderPane.margin>
      </Button>

   </top>

   <center>
      <VBox alignment="CENTER" spacing="30.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblFeedback" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblSpelerToevoegen" text="%SpelerKiezenSpelerToevoegen">
               <font>
                  <Font size="33.0" />
               </font>
            </Label>

            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <TextField fx:id="txfNaam" maxWidth="250.0" promptText="%txtNaam">
                     <font>
                        <Font name="Calibri" size="20.0" />
                     </font>
                  </TextField>
                  <TextField fx:id="txfGeboortejaar" maxWidth="250.0" promptText="%txtGeboortejaar">
                     <font>
                        <Font name="Calibri" size="20.0" />
                     </font>
                  </TextField>
               </children>
            </HBox>

            <Button fx:id="btnRegistreren" mnemonicParsing="false" onAction="#startRegistratieSpeler" prefWidth="200.0" text="%Registreren">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets bottom="50.0" />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
